   # Raw and processed data (too large / shouldn't be versioned)
   week1_project/data/raw/*
   week1_project/data/processed/*.pkl
   !week1_project/data/raw/.gitkeep
   !week1_project/data/processed/.gitkeep

   # full_pipeline: raw/intermediate data and trained model artifacts are
   # regenerated by `python run_pipeline.py` -- don't version them. The
   # small final results (outputs/results/*.json, outputs/plots/*.png) ARE
   # kept committed since they're tiny and let reviewers see results
   # without running anything.
   full_pipeline/data/raw/*
   full_pipeline/data/processed/*
   !full_pipeline/data/raw/.gitkeep
   !full_pipeline/data/processed/.gitkeep
   !full_pipeline/data/processed/models/.gitkeep

   # Python
   __pycache__/
   *.pyc
   *.pyo
   .ipynb_checkpoints/
   .pytest_cache/

   # Environment
   venv/
   .venv/
   *.env

   # OS
   Thumbs.db
   .DS_Store